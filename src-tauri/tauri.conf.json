{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sticklet",
  "version": "0.1.9",
  "identifier": "com.sticklet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "Sticklet",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4REY5NjYzNzM3RTAzRjQKUldUMEEzNXpZNWJmT01oY0xjdmw0SWovU2ZWYzVVeTVMK1psZndGdm0wNFV2TjJkV3JyWmxFYlkK",
      "endpoints": [
        "https://github.com/Sourav1018/sticklet/releases/latest/download/latest.json"
      ]
    }
  }
}
